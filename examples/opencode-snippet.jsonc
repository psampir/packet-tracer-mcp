{
  // Paste the "pt" block below into ~/.config/opencode/opencode.jsonc
  // under the existing "mcp" -> "servers" object. Do not duplicate keys.
  // Adjust paths if you moved the project (the command runs the installed
  // console script, so no PEP 723 header is needed any more).
  "pt": {
    "type": "local",
    "command": [
      "uv",
      "run",
      "--directory",
      "/home/pawel/Code/Projects/packet-tracer-mcp",
      "packet-tracer-mcp"
    ],
    "cwd": "/home/pawel/Code/Projects/packet-tracer-mcp",
    "disabled": false
  }
}
